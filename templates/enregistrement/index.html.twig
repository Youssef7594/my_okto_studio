{% extends 'base.html.twig' %}

{% block title %}Hello EnregistrementController!{% endblock %}

{% block body %}
    <body class="body-enregistrement">
        <main class="main-enregistrement">
        
            <div class="head-enregistrement">
                <h1>Choisir la durée de l'enregistrement</h1>
            </div>
            
                <div class="durations">
                {% for i in 1..5 %}
                    <a href="{{ path('enregistrement_duree', { 'duree': i }) }}">
                        <div class="duration">
                            Réserver pour {{ i }} heure{{ i > 1 ? 's' }}
                        </div>
                    </a>
                {% endfor %}
            </div>

    </main>
</body>

{% endblock %}
