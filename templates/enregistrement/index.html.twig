{% extends 'base.html.twig' %}

{% block title %}Enregistrement{% endblock %}

{% block body %}
    <body class="body-enregistrement">
        <main class="main-enregistrement">
        
            <div class="head-enregistrement">
                <h1>Choisissez la durée de l'enregistrement</h1>
            </div>
            
                <div class="durations">
                {% for i in 1..5 %}
                    <a id="duration-enregistrement" href="{{ path('enregistrement_duree', { 'duree': i }) }}">
                        <div class="duration">
                            Réserver pour {{ i }} heure{{ i > 1 ? 's' }}
                        </div>
                    </a>
                {% endfor %}
            </div>

