{% extends 'base.html.twig' %}

{% block title %}Page d'acceuil{% endblock %}

{% block body %}
    <main id="home">
        <section id="top-home">
            <div container>
                <h1 class="inclusive-sans">
                    <div id="okto">
                        <span>O</span>
                        <span>K</span>
                        <span>T</span>
                        <span>O</span>
                    </div> 
                    <div id="studio">
                        <span>S</span>
                        <span>T</span>
                        <span>U</span>
                        <span>D</span>
                        <span>I</span>
                        <span>O</span>
                    </div>   
                </h1>
            </div>
            <div class="inclusive-sans">
                <button><a href="{{ path('app_enregistrement') }}">Réserver</a></button>
            </div>
        </section>

        <section id="tarifs">
            <div class="container contenu">
                <h2>NOS TARIFS</h2>
                <div class="d-flex justify-content-around">
                    <div class="tarifs">
                        <h3>ENREGISTREMENT</h3>
                        <p class="smaller">TARIF HORAIRE | ENREGISTREMENT SIMPLE (PRE-MIX INCLUS)</p>
                        <p class="bigger">20€/H</p>
                    </div>
                    <div class="tarifs">
                        <h3>MIXAGE</h3>
                        <p class="smaller">TARIF PAR TITRE | MP3/WAVE | PISTE PAR PISTE</p>
                        <p class="bigger">40€</p>
                    </div>
                </div>

                <div class="container d-flex justify-content-around" id="icons">
                    <div>
                        <p class="icon"><i class="fa-solid fa-euro-sign"></i></p>
                        <p>Payement en carte <br> non disponible</p>
                    </div>

                    <div>
                        <p class="icon"><i class="fa-duotone fa-solid fa-user-group"></i></p>
                        <p>Locaux limité <br> à 5 personnes</p>
                    </div>

                    <div>
                        <p class="icon"><i class="fa-duotone fa-solid fa-clock-rotate-left"></i></p>
                        <p>Annullation <br> sous 48H</p>
                    </div>

                    <div>
                        <p class="icon"><i class="fa-duotone fa-solid fa-mug-hot"></i></p>
                        <p>Snacks disponible <br> à l'achat</p>
                    </div>

                    <div>
                        <p class="icon"><i class="fa-solid fa-square-parking"></i></p>
                        <p>Parking <br> disponible</p>
                    </div>
                </div>
            </div>
        </section>

        <section id="about">
            <h2>À PROPOS</h2>

            <div>
                <div class="resume">
                    <p>
                        Je me présente je suis Thomas Bruyère, un passionné de musique comme vous.
                        j'ai fais mes premières sessions dans ma chambre avec des amis, amis d'amis et amis d'inconnu pour arrivé ici.
                        dans mon stud, on enregistre on mix on parle musique bref, une ambiance chill sans prétention pour vous mettre à l'aise et plier des classiques!! <br> 
                        Je suis encore en pleine évolution, je vous fait donc profiter de séances pas chères.
                    </p>
                </div>
    
                <div>
                    <div id="frame">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2636.1901446453676!2d2.302342575570364!3d48.644477571303966!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47e5d9082121fad5%3A0xedbbc35def4964f1!2s31%20Rue%20du%20Haras%2C%2091240%20Saint-Michel-sur-Orge!5e0!3m2!1sfr!2sfr!4v1739361258002!5m2!1sfr!2sfr" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                    </div>
                </div>
            </div>
        </section>

        <section id="contact">
            <h2>NOS CONTACTS</h2>

            <div class="d-flex justify-content-around container ">
                <div>
                    <p class="icon"><i class="fa-solid fa-envelope"></i></p>
                    <p><a href="mailto:thomasbruyère@gmail.com">thomasbruyère@gmail.com</a></p>
                </div>

                <div>
                    <p class="icon"><i class="fa-solid fa-phone"></i></p>
                    <p><a href="tel:06 80 03 61 13">06 80 03 61 13</a></p>
                </div>

                <div>
                    <p class="icon"><i class="fa-solid fa-location-dot"></i></p>
                    <p>31 Rue du Haras<br>91240, Saint-Michel-sur-Orge</p>
                </div>
            </div>
        </section>

    </main>
{% endblock %}
